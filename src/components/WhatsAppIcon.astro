<style is:global>
  .wa-icon { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 50%; background: #25d366; color: #fff !important; flex: 0 0 auto; margin-left: .6rem; box-shadow: 0 2px 8px rgba(0,0,0,.2); transition: transform .15s ease; text-decoration: none; }
  .wa-icon:hover { transform: scale(1.08); }
  .wa-icon svg { width: 22px; height: 22px; display: block; }
  li.wa-li { display: flex; align-items: center; list-style: none; }
</style>
<script>
  const URL_WA = 'https://wa.me/254728093770?text=Hello%20PCEA%20Nthambo%20Church%2C%20I%20found%20your%20website%20and%20would%20like%20to%20know%20more%20about%20the%20church%20and%20its%20services.%20Please%20assist%20me.%20Thank%20you.';
  const header = document.querySelector('header');

  // Remove any floating chat button (fixed-position element only)
  function removeFloating() {
    const found = Array.from(document.querySelectorAll('a, button')).filter((el) => {
      if (el.classList.contains('wa-icon')) return false;
      const t = (el.textContent || '').trim();
      const href = el.getAttribute('href') || '';
      return /chat with us/i.test(t) || /wa\.me|whatsapp/i.test(href);
    });
    found.forEach((el) => {
      let n = el;
      while (n && n !== document.body) {
        if (getComputedStyle(n).position === 'fixed') { n.remove(); return; }
        n = n.parentElement;
      }
    });
  }
  removeFloating();
  const obs = new MutationObserver(removeFloating);
  obs.observe(document.body, { childList: true, subtree: true });
  setTimeout(() => obs.disconnect(), 8000);

  if (header) {
    const icon = document.createElement('a');
    icon.className = 'wa-icon';
    icon.href = URL_WA;
    icon.target = '_blank';
    icon.rel = 'noopener noreferrer';
    icon.setAttribute('aria-label', 'Chat with us on WhatsApp');
    icon.title = 'Chat with us on WhatsApp';
    icon.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>';

    const place = () => {
      const links = Array.from(header.querySelectorAll('nav a'));
      const contact = links.find((a) => /^contact$/i.test((a.textContent || '').trim()));
      const burger = header.querySelector('button[aria-label*="menu" i], button[aria-controls], button[class*="burger" i], button[class*="toggle" i], button[class*="menu" i]');
      if (contact && contact.offsetParent !== null) {
        const li = contact.closest('li');
        if (li && li.parentElement) {
          let wrap = header.querySelector('li.wa-li');
          if (!wrap) { wrap = document.createElement('li'); wrap.className = 'wa-li'; }
          wrap.appendChild(icon);
          if (wrap.previousElementSibling !== li) li.after(wrap);
        } else if (icon.previousElementSibling !== contact) {
          contact.after(icon);
        }
      } else if (burger) {
        const wrap = header.querySelector('li.wa-li'); if (wrap) wrap.remove();
        burger.before(icon);
      } else if (!icon.isConnected) {
        (header.querySelector('nav') || header).appendChild(icon);
      }
    };
    place();
    window.addEventListener('resize', place);
  }
</script>
