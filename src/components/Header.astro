---
import site from '../data/site.json';
import ministries from '../data/ministries.json';
import { safeUrl } from '../lib/format.js';

const s: any = site;
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const ministryLinks = ((ministries as any).items ?? []).map((m: any) => ({ label: m.name, href: '/ministries/#' + slug(m.name) }));

const nav: any[] = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/', children: [
    { label: 'About us', href: '/about/' },
    { label: 'Our history', href: '/history/' },
  ] },
  { label: 'Ministries', href: '/ministries/', children: ministryLinks },
  { label: 'Services', href: '/services/' },
  { label: 'Events', href: '/events/' },
  { label: 'Media', href: '/sermons/', children: [
    { label: 'Sermons', href: '/sermons/' },
    { label: 'Videos', href: '/videos/' },
    { label: 'Blog', href: '/blog/' },
  ] },
  { label: 'Contact', href: '/contact/' },
];

const path = Astro.url.pathname;
const on = (href: string) => { const h = href.split('#')[0]; return h === '/' ? path === '/' : path.startsWith(h); };
const items = nav.map((n) => ({
  ...n,
  kids: n.children ?? [],
  active: on(n.href) || (n.children ?? []).some((c: any) => on(c.href)),
}));
const facebook = safeUrl(s.social?.facebook);
const give = safeUrl(s.give?.url);
---

<header class="nh">
  <div class="nh-top">
    <div class="container nh-top-in">
      <span>{s.contact?.address}</span>
      {facebook && <a href={facebook} target="_blank" rel="noopener noreferrer">Facebook</a>}
    </div>
  </div>
  <div class="nh-main">
    <div class="container nh-bar">
      <a class="nh-brand" href="/" aria-label={s.name + ' home'}>
        {s.logo && <img src={s.logo} alt="" height="54" />}
        <span class="nh-brand-text">
          <span class="nh-name">{s.name}</span>
          <span class="nh-tag">Magumoni Parish · Chuka Presbytery</span>
        </span>
      </a>
      <button class="nh-toggle" type="button" aria-expanded="false" aria-controls="nh-nav" aria-label="Open menu"><span></span><span></span><span></span></button>
      <nav id="nh-nav" class="nh-nav" aria-label="Main">
        <ul class="nh-list">
          {items.map((item) => (
            <li class={'nh-item' + (item.active ? ' active' : '') + (item.kids.length > 0 ? ' has-sub' : '')}>
              <a class="nh-link" href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
              {item.kids.length > 0 && (
                <button class="nh-caret" type="button" aria-expanded="false" aria-label={'Show ' + item.label + ' menu'}>
                  <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              )}
              {item.kids.length > 0 && (
                <ul class="nh-sub">
                  {item.kids.map((c: any) => <li><a href={c.href}>{c.label}</a></li>)}
                </ul>
              )}
            </li>
          ))}
          {give && <li class="nh-item"><a class="nh-give" href={give} target="_blank" rel="noopener noreferrer">{s.give?.label ?? 'Give'}</a></li>}
        </ul>
      </nav>
    </div>
  </div>
</header>

<style is:global>
  .nh { position: sticky; top: 0; z-index: 900; background: #fff; box-shadow: 0 2px 10px rgba(0,0,0,.08); }
  .nh-top { background: #14306a; color: #fff; font-size: .78rem; }
  .nh-top-in { display: flex; justify-content: space-between; gap: 1rem; padding-top: .45rem; padding-bottom: .45rem; }
  .nh-top a { color: #fff; text-decoration: underline; }
  .nh-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 74px; }
  .nh-brand { display: flex; align-items: center; gap: .7rem; text-decoration: none; color: #14306a; }
  .nh-brand img { height: 54px; width: auto; display: block; }
  .nh-brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .nh-name { font-family: 'Orpheum', 'Montserrat', 'Segoe UI', system-ui, sans-serif; font-weight: 800; font-size: 1.25rem; letter-spacing: .03em; text-transform: uppercase; }
  .nh-tag { margin-top: .3rem; font-size: .62rem; letter-spacing: .22em; text-transform: uppercase; color: #1e4f9c; }
  .nh-toggle { display: none; background: none; border: 0; padding: .5rem; cursor: pointer; }
  .nh-toggle span { display: block; width: 24px; height: 2px; background: #14306a; margin: 5px 0; }
  .nh-nav { display: flex; align-items: center; }
  .nh-list { display: flex; align-items: center; gap: .15rem; list-style: none; margin: 0; padding: 0; }
  .nh-item { position: relative; display: flex; align-items: center; }
  .nh-link { padding: .6rem .55rem; font-weight: 600; font-size: .88rem; color: #14306a; text-decoration: none; }
  .nh-link:hover, .nh-item.active > .nh-link { color: #b8402f; }
  .nh-caret { background: none; border: 0; color: #14306a; cursor: pointer; padding: .5rem .3rem .5rem 0; display: flex; align-items: center; }
  .nh-sub { display: none; position: absolute; top: 100%; left: 0; min-width: 240px; background: #fff; list-style: none; margin: 0; padding: .4rem 0; border-top: 3px solid #f4c15d; box-shadow: 0 10px 28px rgba(0,0,0,.18); z-index: 950; }
  .nh-sub a { display: block; padding: .6rem 1rem; color: #14306a; font-size: .88rem; text-decoration: none; }
  .nh-sub a:hover { background: #f1f4fa; color: #b8402f; }
  .nh-item:hover > .nh-sub, .nh-item:focus-within > .nh-sub, .nh-item.open > .nh-sub { display: block; }
  .nh-give { margin-left: .5rem; background: #1e4f9c; color: #fff; padding: .55rem 1.1rem; border-radius: 6px; font-weight: 700; font-size: .85rem; text-decoration: none; }
  @media (max-width: 960px) {
    .nh-toggle { display: block; }
    .nh-nav { display: none; position: absolute; top: 100%; left: 0; right: 0; background: #fff; max-height: 80vh; overflow-y: auto; box-shadow: 0 10px 20px rgba(0,0,0,.15); }
    .nh-nav.open { display: block; }
    .nh-list { flex-direction: column; align-items: stretch; padding: .5rem 1rem 1rem; gap: 0; }
    .nh-item { flex-wrap: wrap; justify-content: space-between; border-bottom: 1px solid #e8ecf3; }
    .nh-link { flex: 1; padding: .85rem 0; }
    .nh-caret { padding: .85rem .5rem; }
    .nh-sub { position: static; display: none; width: 100%; box-shadow: none; border-top: 0; background: #f6f8fc; }
    .nh-item:hover > .nh-sub, .nh-item:focus-within > .nh-sub { display: none; }
    .nh-item.open > .nh-sub { display: block; }
    .nh-give { margin: .8rem 0 0; display: inline-block; }
    .nh-tag { display: none; }
  }
</style>

<script>
  const toggle = document.querySelector('.nh-toggle');
  const nav = document.getElementById('nh-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
  document.querySelectorAll('.nh-caret').forEach((btn) => {
    btn.addEventListener('click', () => {
      const li = btn.closest('.nh-item');
      if (!li) return;
      const open = li.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  });
</script>