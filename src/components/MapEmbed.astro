---
const q = encodeURIComponent('Nthambo, Magumoni, Tharaka-Nithi County, Kenya');
const src = 'https://maps.google.com/maps?q=' + q + '&z=14&output=embed';
---
<div class="map-embed">
  <iframe src={src} title="Map showing the PCEA Nthambo Church area" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
</div>