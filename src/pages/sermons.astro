---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import data from '../data/sermons.json';
import { newestFirst, formatDate, safeUrl } from '../lib/format.js';

const sermons = newestFirst(data.items as any[]);
---
<BaseLayout title="Sermons" description="Sermon recordings.">
  <PageHeader title="Sermons" />
  <section class="section">
    <div class="container">
      {sermons.length > 0 ? (
        <ul class="card-list">
          {sermons.map((s) => (
            <li class="card">
              <h3>{s.title}</h3>
              <p class="meta">{[s.speaker, formatDate(s.date)].filter(Boolean).join(' · ')}</p>
              {s.scripture && <p><strong>Scripture:</strong> {s.scripture}</p>}
              <div class="link-row">
                {safeUrl(s.videoUrl) && <a class="btn" href={safeUrl(s.videoUrl)} target="_blank" rel="noopener noreferrer">Watch</a>}
                {safeUrl(s.audioUrl) && <a class="btn" href={safeUrl(s.audioUrl)} target="_blank" rel="noopener noreferrer">Listen</a>}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="notice">Sermon recordings will be added soon.</p>
      )}
    </div>
  </section>
</BaseLayout>