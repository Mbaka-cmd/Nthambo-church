---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import data from '../data/ministries.json';
import { slugify } from '../lib/format.js';

const items = data.items as any[];
---
<BaseLayout title="Ministries" description="Ministries and groups you can join.">
  <PageHeader title="Ministries" />
  <section class="section">
    <div class="container">
      {items.length > 0 ? (
        <ul class="card-list">
          {items.map((m) => (
            <li class="card" id={slugify(m.name)}>
              <Photo src={m.image} alt={m.name} />
              <h3>{m.name}</h3>
              {m.meets && <p class="meta">{m.meets}</p>}
              {m.description && <p>{m.description}</p>}
              {m.leader && <p><strong>Leader:</strong> {m.leader}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="notice">Our ministries will be listed here soon.</p>
      )}
    </div>
  </section>
</BaseLayout>