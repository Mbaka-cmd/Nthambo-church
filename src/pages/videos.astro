---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FacebookReel from '../components/FacebookReel.astro';
import data from '../data/videos.json';
import { safeUrl } from '../lib/format.js';

const videos = (data.items as any[]).filter((v) => safeUrl(v.url));
---
<BaseLayout title="Videos" description="Videos from our church life.">
  <PageHeader title="Videos" />
  <section class="section">
    <div class="container">
      {videos.length > 0 ? (
        <ul class="card-list">
          {videos.map((v) => (
            <li class="card">
              <FacebookReel url={safeUrl(v.url)} title={v.title} thumb={v.thumb} />
              <h3>{v.title}</h3>
              <p><a class="btn" href={safeUrl(v.url)} target="_blank" rel="noopener noreferrer">Watch on Facebook</a></p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="notice">Videos will be added soon.</p>
      )}
    </div>
  </section>
</BaseLayout>