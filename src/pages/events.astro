---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import data from '../data/events.json';
import { upcoming, formatDate } from '../lib/format.js';

const events = upcoming(data.items as any[]);
---
<BaseLayout title="Events" description="Upcoming church events.">
  <PageHeader title="Upcoming events" />
  <section class="section">
    <div class="container">
      {events.length > 0 ? (
        <ul class="card-list">
          {events.map((e) => (
            <li class="card">
              <h3>{e.title}</h3>
              <p class="meta">{[formatDate(e.date), e.time].filter(Boolean).join(' · ')}</p>
              {e.location && <p><strong>Where:</strong> {e.location}</p>}
              {e.description && <p>{e.description}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="notice">No upcoming events have been published yet.</p>
      )}
    </div>
  </section>
</BaseLayout>