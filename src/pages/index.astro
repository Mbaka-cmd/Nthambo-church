---
import site from '../data/site.json';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name}</title>
  </head>
  <body>
    <h1>{site.name}</h1>
    <p>{site.tagline ?? "Welcome. Full details coming soon."}</p>
    <p>Service times: {site.services.length ? site.services.length + " listed" : "to be confirmed"}</p>
  </body>
</html>