---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import data from '../data/sermons.json';
import { newestFirst, formatDate, safeUrl, youtubeId } from '../lib/format.js';

const sermons = newestFirst(data.items as any[]);
---
<BaseLayout title="Sermons" description="Sermon recordings.">
  <PageHeader title="Sermons" />
  <section class="section">
    <div class="container">
      {sermons.length > 0 ? (
        <ul class="card-list">
          {sermons.map((s) => (
            <li class="card">
              {youtubeId(s.youtubeUrl) ? <YouTubeEmbed url={s.youtubeUrl} title={s.title} /> : <Photo src={s.image} alt={s.title} />}
              <h3>{s.title}</h3>
              <p class="meta">{[s.speaker, formatDate(s.date)].filter(Boolean).join(' · ')}</p>
              {s.scripture && <p><strong>Scripture:</strong> {s.scripture}</p>}
              {safeUrl(s.audioUrl) && <a href={safeUrl(s.audioUrl)} target="_blank" rel="noopener noreferrer">Listen (audio)</a>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="notice">Sermon recordings will be added soon.</p>
      )}
    </div>
  </section>
</BaseLayout>